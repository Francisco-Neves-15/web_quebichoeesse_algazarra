{
  "name": "quebichoeesse-algazarra-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css,md}\"",
    "typecheck": "tsc --noEmit",
    "lint:errors": "eslint ./src --ext .ts,.tsx --max-warnings 10",
    "validate": "npm run typecheck && npm run lint:errors",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,css,md}\"",
    "validate:full": "npm run format:fix && npm run validate",
    "check:jsx": "node scripts/check-jsx.js",
    "check:css": "node scripts/check-css-imports.js",
    "prepare": "husky",
    "build:check": "next build",
    "package:lock": "node scripts/lock-packages.js",
    "package:check": "node scripts/check-locked-packages.js"
  },
  "dependencies": {
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9",
    "eslint-config-next": "16.1.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "sass": "1.97.1",
    "tailwindcss": "4",
    "typescript": "5"
  }
}
