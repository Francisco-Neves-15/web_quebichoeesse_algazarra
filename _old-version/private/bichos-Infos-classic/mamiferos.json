{
    "code": "mam",
    "categName": "Mamíferos",
    "animals": [
        {
            "id": 1,
            "name": "Javali",
            "tips": {
                "1": "É o prato favorito de Astexrix, Obelix e de todos os gauleses (Desenho).",
                "2": "É o ancestral do porco doméstico.",
                "3": "Seus dentes caninos, em forma de foice, crescem continuamente; nos machos são tão desenvolvidos do que se projetam para fora da boca.",
                "4": "Sua alimentação inclui vegetais, frutos, insetos, roedores, sapos, peixes, cobras, aves que chocam os osvos no chão, e até os ovos.",
                "5": "Na TV ou no cinema sou o Pumba.",
                "6": "Sua visão é muito fraca; em compensação, a audição e o olfato são excelentes.",
                "7": "Quando está irritado, bufa e eriça os pêlos das costas.",
                "8": "Seus filhotes caracterizam-se pelas listras nos pêlos."
            }
        },
